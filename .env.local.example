# Local environment variables for development (DO NOT commit secrets)
# Copy this file to `.env.local` and fill in your real API keys.

# Google Generative Language / Gemini API Key
# You can create an API key in Google Cloud Console -> APIs & Services -> Credentials
VITE_GEMINI_API_KEY=your_google_api_key_here

# ElevenLabs TTS API key
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Backend API base URL (for auth/counsel endpoints)
VITE_API_BASE_URL=http://localhost:3000/api

# Counseling websocket base URL
VITE_COUNSEL_WS_BASE_URL=ws://13.209.88.175:8000/ws/counseling

# API request timeout in milliseconds
VITE_API_TIMEOUT_MS=15000

# Enable backend auth API (/auth/login, /auth/signup, /auth/refresh)
VITE_USE_BACKEND_AUTH=false

# If backend auth fails, use local demo auth fallback
VITE_ALLOW_DEMO_AUTH_FALLBACK=true

# Hide VRM model on counsel page in development for debugging
VITE_HIDE_VRM_MODEL=false
